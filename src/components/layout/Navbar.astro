---
import { ArrowUpRight } from '@lucide/astro';
import { hasEmail, mailtoHref, portfolio } from '../../data/portfolio';
import SocialLinks from '../ui/SocialLinks.astro';

const { navigation, identity } = portfolio;
---

<header class="site-header" data-header>
  <div class="site-header__inner shell">
    <a class="brand" href="/#home" aria-label={`${identity.name} — back to home`}>
      <span class="brand__mark" aria-hidden="true">
        <span class="brand__letter">{identity.monogram}</span>
        <span class="brand__dot"></span>
      </span>
      <span class="brand__name">{identity.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul class="nav-desktop__list">
        {
          navigation.map((item) => (
            <li>
              <a class="nav-desktop__link" href={item.href} data-nav-link data-section-id={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      {
        hasEmail && (
          <a class="nav-email" href={mailtoHref}>
            Email
          </a>
        )
      }
      <a class="nav-cta" href="/#contact">
        <span>Let’s talk</span>
        <ArrowUpRight size={14} stroke-width={1.5} aria-hidden="true" />
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-toggle
      >
        <span class="menu-toggle__label" data-menu-label>Menu</span>
        <span class="menu-toggle__icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<div
  class="nav-panel"
  id="mobile-navigation"
  data-menu-panel
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  aria-hidden="true"
  inert
>
  <div class="nav-panel__inner shell">
    <div class="nav-panel__meta">
      <p class="mono-label">Index / 2026</p>
      <p class="mono-label">Sandesh — Developer</p>
    </div>

    <nav class="nav-panel__nav" aria-label="Mobile primary">
      <ul class="nav-panel__list">
        {
          navigation.map((item, index) => (
            <li class="nav-panel__item" style={`--i: ${index}`}>
              <a
                class="nav-panel__link"
                href={item.href}
                data-nav-link
                data-menu-link
                data-section-id={item.id}
              >
                <span class="nav-panel__index">{String(index + 1).padStart(2, '0')}</span>
                <span class="nav-panel__label">{item.label}</span>
                <ArrowUpRight
                  class="nav-panel__arrow"
                  size={22}
                  stroke-width={1.25}
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-panel__foot">
      <div class="nav-panel__foot-group">
        <p class="mono-label">Elsewhere</p>
        <SocialLinks variant="inline" />
      </div>
      <p class="mono-label nav-panel__footline">
        Computer Science &amp; Engineering<br />New Horizon College of Engineering
      </p>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      background-color var(--dur-med) var(--ease-out),
      border-color var(--dur-med) var(--ease-out);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    background: rgba(10, 11, 9, 0.96);
  }

  .site-header.is-menu-open {
    border-bottom-color: transparent;
    background: transparent;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    justify-self: start;
    width: fit-content;
  }

  .brand__mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line-strong);
    transition: border-color var(--dur-fast) ease;
  }

  .brand__letter {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1;
    transform: translateY(-0.02em);
  }

  .brand__dot {
    position: absolute;
    top: -0.2rem;
    right: -0.2rem;
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: var(--lime);
  }

  .brand:hover .brand__mark {
    border-color: var(--lime);
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
  }

  .nav-desktop__list {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 2.5vw, 2.35rem);
  }

  .nav-desktop__link {
    position: relative;
    display: inline-block;
    padding-block: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--muted-strong);
    transition: color var(--dur-fast) ease;
  }

  .nav-desktop__link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--lime);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-med) var(--ease-out);
  }

  .nav-desktop__link:hover {
    color: var(--ink);
  }

  .nav-desktop__link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-desktop__link.is-active {
    color: var(--ink);
  }

  .nav-desktop__link.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 1.4rem;
  }

  .nav-email,
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    transition: color var(--dur-fast) ease;
  }

  .nav-cta {
    color: var(--lime);
  }

  .nav-email {
    color: var(--muted-strong);
  }

  .nav-email:hover,
  .nav-cta:hover {
    color: var(--ink);
  }

  .nav-cta svg {
    transition: transform var(--dur-med) var(--ease-out);
  }

  .nav-cta:hover svg {
    transform: translate(2px, -2px);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .menu-toggle__icon {
    position: relative;
    display: block;
    width: 1.1rem;
    height: 0.55rem;
  }

  .menu-toggle__icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition:
      transform var(--dur-med) var(--ease-out),
      top var(--dur-med) var(--ease-out),
      bottom var(--dur-med) var(--ease-out);
  }

  .menu-toggle__icon span:first-child {
    top: 0;
  }

  .menu-toggle__icon span:last-child {
    bottom: 0;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon span:first-child {
    top: calc(50% - 0.5px);
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon span:last-child {
    bottom: calc(50% - 0.5px);
    transform: rotate(-45deg);
  }

  .nav-panel {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    overflow-y: auto;
    overscroll-behavior: contain;
    background:
      radial-gradient(circle at 12% 88%, rgba(201, 244, 90, 0.09), transparent 36%),
      var(--bg);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-1rem);
    transition:
      opacity 320ms var(--ease-out),
      transform 520ms var(--ease-out),
      visibility 0s linear 520ms;
    pointer-events: none;
  }

  .nav-panel.is-open {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 420ms var(--ease-out),
      transform 680ms var(--ease-out),
      visibility 0s linear 0s;
    pointer-events: auto;
  }

  .nav-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(241, 239, 230, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(241, 239, 230, 0.035) 1px, transparent 1px);
    background-size: 100% 7.5rem, 25% 100%;
  }

  .nav-panel__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(1rem, 4vh, 2.5rem));
    padding-bottom: clamp(1.5rem, 4vh, 3rem);
  }

  .nav-panel__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--line);
  }

  .nav-panel__nav {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: clamp(1rem, 3vh, 2.5rem);
  }

  .nav-panel__list {
    width: 100%;
  }

  .nav-panel__item {
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(1.2rem);
    transition:
      opacity 420ms var(--ease-out),
      transform 620ms var(--ease-out);
    transition-delay: calc(70ms + var(--i) * 45ms);
  }

  .nav-panel__list {
    border-top: 1px solid var(--line);
  }

  .nav-panel.is-open .nav-panel__item {
    opacity: 1;
    transform: translateY(0);
  }

  .nav-panel__link {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding-block: clamp(0.35rem, 1.2vh, 0.7rem);
    color: var(--ink);
  }

  .nav-panel__index {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    align-self: center;
  }

  .nav-panel__label {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 11vw, 5.4rem);
    font-weight: 580;
    line-height: 0.9;
    letter-spacing: 0.015em;
    text-transform: uppercase;
    transition: color var(--dur-fast) ease;
  }

  .nav-panel__link:hover .nav-panel__label,
  .nav-panel__link.is-active .nav-panel__label {
    color: var(--lime);
  }

  .nav-panel__arrow {
    color: var(--muted);
    transition:
      transform var(--dur-med) var(--ease-out),
      color var(--dur-fast) ease;
  }

  .nav-panel__link:hover .nav-panel__arrow {
    color: var(--lime);
    transform: translate(3px, -3px);
  }

  .nav-panel__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .nav-panel__foot-group {
    display: grid;
    gap: 0.7rem;
  }

  .nav-panel__footline {
    text-align: right;
  }

  @media (max-width: 1024px) {
    .nav-desktop {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .site-header__inner {
      grid-template-columns: 1fr auto;
    }
  }

  @media (max-width: 560px) {
    .nav-cta {
      display: none;
    }

    .site-header__actions {
      gap: 1rem;
    }

    .nav-panel__meta {
      display: none;
    }

    .nav-panel__inner {
      padding-top: calc(var(--header-h) + 0.75rem);
    }

    .nav-panel__foot {
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-panel__footline {
      text-align: left;
    }
  }
</style>
