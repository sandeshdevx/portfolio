---
import { ArrowUp, ArrowUpRight, FileDown, Mail } from '@lucide/astro';
import BrandGlyph from '../ui/BrandGlyph.astro';
import {
  hasEmail,
  hasResume,
  mailtoHref,
  portfolio,
  resumeHref,
} from '../../data/portfolio';

const { identity, contact, socialLinks } = portfolio;
const hasRoutes = hasEmail || hasResume || socialLinks.length > 0;
---

<section class="contact" id="contact" data-section aria-labelledby="contact-title">
  <div class="contact__inner shell">
    <p class="contact__label">Contact</p>

    <div class="contact__lead" data-reveal>
      <h2 id="contact-title">Have a problem worth building around?</h2>
      <p>
        {
          hasEmail
            ? 'For internships, collaborations or a question about the work, write directly. I read every considered note.'
            : 'I am open to internship and early-career opportunities, collaborative projects, and conversations about software, web engineering and applied AI.'
        }
      </p>
    </div>

    <div class="contact__routes" data-reveal>
      <p class="contact__routes-label">The most direct route</p>

      <ul>
        {
          hasEmail && (
            <li>
              <a
                class="contact__route"
                href={mailtoHref}
                aria-label={`Email ${identity.name}`}
              >
                <Mail size={22} stroke-width={1.4} aria-hidden="true" />
                <span class="contact__route-kind">Email</span>
                <span class="contact__route-value">{contact.email}</span>
                <ArrowUpRight size={22} stroke-width={1.3} aria-hidden="true" />
              </a>
            </li>
          )
        }
        {
          socialLinks.map((link) => (
            <li>
              <a
                class="contact__route"
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${link.label} — ${link.display} — opens in a new tab`}
              >
                <BrandGlyph platform={link.platform} size={22} />
                <span class="contact__route-kind">{link.label}</span>
                <span class="contact__route-value">{link.display}</span>
                <ArrowUpRight size={22} stroke-width={1.3} aria-hidden="true" />
              </a>
            </li>
          ))
        }
        {
          hasResume && (
            <li>
              <a class="contact__route" href={resumeHref} download>
                <FileDown size={22} stroke-width={1.4} aria-hidden="true" />
                <span class="contact__route-kind">Résumé</span>
                <span class="contact__route-value">Download PDF</span>
                <ArrowUpRight size={22} stroke-width={1.3} aria-hidden="true" />
              </a>
            </li>
          )
        }
      </ul>

      {!hasRoutes && <p class="contact__empty">Contact details are being updated.</p>}
    </div>

    <div class="contact__bottom">
      <p>
        <span class="contact__status" aria-hidden="true"></span>
        {identity.availability}
      </p>
      <a class="contact__back" href="#home">
        Back to top
        <ArrowUp size={15} stroke-width={1.5} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: clip;
    background: var(--lime);
    color: var(--lime-ink);
  }

  .contact::after {
    content: 'S';
    position: absolute;
    right: -0.04em;
    bottom: -0.3em;
    font-family: var(--font-display);
    font-size: clamp(18rem, 48vw, 46rem);
    font-weight: 700;
    line-height: 0.65;
    color: rgba(10, 11, 9, 0.065);
    pointer-events: none;
  }

  .contact__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.34fr) minmax(0, 1fr) minmax(17rem, 0.68fr);
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-block: clamp(4.5rem, 9vw, 8rem) clamp(2.5rem, 5vw, 4rem);
  }

  .contact__label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(10, 11, 9, 0.62);
  }

  .contact__lead {
    max-width: 43rem;
  }

  .contact__lead h2 {
    max-width: 14ch;
    font-family: var(--font-sans);
    font-size: clamp(2.7rem, 5.6vw, 5.6rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.055em;
    text-transform: none;
  }

  .contact__lead > p {
    max-width: 47ch;
    margin-top: 1.5rem;
    color: rgba(10, 11, 9, 0.7);
    font-size: 0.97rem;
    line-height: 1.7;
  }

  .contact__routes {
    padding-top: 0.25rem;
  }

  .contact__routes-label {
    margin-bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(10, 11, 9, 0.58);
  }

  .contact__routes ul {
    border-top: 1px solid rgba(10, 11, 9, 0.25);
  }

  .contact__route {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 0.4fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding-block: 1.2rem;
    border-bottom: 1px solid rgba(10, 11, 9, 0.25);
    color: var(--lime-ink);
  }

  .contact__route-kind {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(10, 11, 9, 0.6);
  }

  .contact__route-value {
    justify-self: end;
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    font-weight: 560;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .contact__route svg:last-child {
    transition: transform var(--dur-med) var(--ease-out);
  }

  .contact__route:hover svg:last-child {
    transform: translate(3px, -3px);
  }

  .contact__empty {
    color: rgba(10, 11, 9, 0.65);
    font-size: 0.85rem;
  }

  .contact__bottom {
    grid-column: 2 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(3rem, 7vw, 6rem);
    padding-top: 1.3rem;
    border-top: 1px solid rgba(10, 11, 9, 0.25);
    font-family: var(--font-mono);
    font-size: 0.61rem;
    letter-spacing: 0.04em;
    line-height: 1.6;
    text-transform: uppercase;
    color: rgba(10, 11, 9, 0.68);
  }

  .contact__bottom > p {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .contact__status {
    width: 0.46rem;
    height: 0.46rem;
    flex: none;
    margin-top: 0.38rem;
    background: var(--lime-ink);
  }

  .contact__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--lime-ink);
    transition: gap var(--dur-fast) ease;
  }

  .contact__back:hover {
    gap: 0.8rem;
  }

  .contact__back svg {
    transition: transform var(--dur-med) var(--ease-out);
  }

  .contact__back:hover svg {
    transform: translateY(-3px);
  }

  @media (max-width: 1050px) {
    .contact__inner {
      grid-template-columns: minmax(0, 0.25fr) minmax(0, 1fr);
    }

    .contact__routes {
      grid-column: 2;
    }

    .contact__bottom {
      grid-column: 2;
    }
  }

  @media (max-width: 760px) {
    .contact__inner {
      grid-template-columns: 1fr;
    }

    .contact__routes,
    .contact__bottom {
      grid-column: 1;
    }

    .contact__lead h2 {
      max-width: 12ch;
    }

    .contact__route {
      grid-template-columns: 1.5rem minmax(0, 1fr) auto;
    }

    .contact__route-kind {
      display: none;
    }

    .contact__route-value {
      justify-self: start;
    }

    .contact__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
