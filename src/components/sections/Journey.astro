---
import { portfolio } from '../../data/portfolio';

const { certifications, achievements } = portfolio;
---

<section class="journey" id="journey" data-section aria-labelledby="journey-title">
  <div class="shell">
    <header class="journey__header" data-reveal>
      <div>
        <p class="journey__label">Certifications & Recognition</p>
        <h2 class="journey__title" id="journey-title">Credentials and achievements.</h2>
      </div>
    </header>

    <div class="journey__grid">
      {certifications.map((cert, i) => (
        <div key={i} class="journey__card" data-reveal>
          <div class="journey__card-header">
            <span class="journey__card-issuer">{cert.issuer}</span>
            <span class="journey__card-year">{cert.year || '2025'}</span>
          </div>
          <h3 class="journey__card-name">{cert.name}</h3>
          <a
            class="journey__card-verify"
            href={cert.verificationUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Verify credential
          </a>
        </div>
      ))}

      {achievements.map((ach, i) => (
        <div key={i} class="journey__achievement" data-reveal>
          <span class="journey__achievement-badge">Achievement</span>
          <h3 class="journey__achievement-name">
            <a class="journey__achievement-verify" href={ach.verificationUrl} target="_blank" rel="noopener noreferrer">
              {ach.name}
            </a>
          </h3>
          <p class="journey__achievement-issuer">{ach.issuer}</p>
          {ach.year && (
            <p class="journey__achievement-year">{ach.year}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .journey {
    position: relative;
    padding-block: clamp(6rem, 10vw, 9rem);
    background:
      radial-gradient(circle at 84% 18%, rgba(201, 244, 90, 0.055), transparent 27rem),
      var(--bg-soft);
  }

  .journey__header {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 0.6fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .journey__label {
    margin-bottom: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .journey__title {
    max-width: 12ch;
    font-family: var(--font-sans);
    font-size: clamp(2.4rem, 4.3vw, 4rem);
    font-weight: 480;
    line-height: 0.98;
    letter-spacing: -0.05em;
    text-transform: none;
  }

  .journey__grid {
    display: grid;
    gap: clamp(2rem, 6vw, 4rem);
  }

  .journey__card {
    background: var(--ink);
    border: 1px solid var(--line);
    border-radius: 0;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    transition: border-color var(--dur-fast) ease;
  }

  .journey__card:hover {
    border-color: var(--lime);
  }

  .journey__card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .journey__card-issuer {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .journey__card-year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    margin-left: 0.5rem;
  }

  .journey__card-name {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 560;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--bg);
  }

  .journey__card-verify {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink);
    font-weight: 560;
    text-decoration: underline;
    text-decoration-color: var(--lime);
    text-decoration-thickness: 0.08rem;
    transition: color var(--dur-fast) ease;
  }

  .journey__card-verify:hover {
    color: var(--lime);
  }

  .journey__card-verify:focus-visible {
    color: var(--lime);
    outline: 2px solid var(--lime);
    outline-offset: 2px;
  }

  .journey__achievement-year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }

  .journey__achievement-verify {
    color: var(--ink);
    text-decoration: underline var(--lime);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color var(--dur-fast) ease, text-decoration-color var(--dur-fast) ease;
  }

  .journey__achievement-verify:hover {
    color: var(--lime);
    text-decoration-color: var(--bg);
  }

  .journey__achievement-verify:focus-visible {
    color: var(--lime);
    outline: 2px solid var(--lime);
    outline-offset: 2px;
  }

  .journey__achievement {
    background: var(--ink);
    border: 1px solid var(--line);
    border-radius: 0;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.5rem 1rem;
    align-items: center;
  }

  .journey__achievement-badge {
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .journey__achievement-name {
    grid-column: 2;
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 560;
    line-height: 1.3;
    color: var(--bg);
  }

  .journey__achievement-issuer {
    grid-column: 3;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .journey__header {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.4rem;
    }

    .journey__achievement {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .journey__achievement-badge {
      grid-row: auto;
    }
  }
</style>