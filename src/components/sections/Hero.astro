---
import Button from '../ui/Button.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { portfolio } from '../../data/portfolio';

const { identity } = portfolio;
const { lead, accent, tail } = identity.heroStatement;
---

<section class="hero" id="home" data-section aria-labelledby="hero-title">
  <div class="hero__ambient" aria-hidden="true">
    <div class="hero__ambient-grid"></div>
    <div class="hero__ambient-glow"></div>
  </div>

  <div class="hero__inner shell">
    <div class="hero__meta">
      <p class="mono-label hero__status">
        <span class="status-dot" aria-hidden="true"></span>
        {identity.availability}
      </p>
      <p class="mono-label hero__discipline">{identity.discipline}</p>
      <p class="mono-label hero__folio">Portfolio / 2026</p>
    </div>

    <div class="hero__stage">
      <div class="hero__copy">
        <p class="hero__eyebrow">
          <span aria-hidden="true">[</span>
          Computer Science Student &amp; Developer
          <span aria-hidden="true">]</span>
        </p>
        <h1 class="hero__title" id="hero-title">
          <span class="hero__line">
            <span class="hero__name">{identity.name.toUpperCase()}</span>
          </span>
          <span class="hero__title-dot" aria-hidden="true"></span>
        </h1>
        <p class="hero__statement">
          {lead} <em>{accent}</em> {tail}
        </p>
      </div>

      <div class="hero__scene">
        <div class="hero__fallback" aria-hidden="true">
          <div class="orbital">
            <span class="orbital__ring orbital__ring--a"></span>
            <span class="orbital__ring orbital__ring--b"></span>
            <span class="orbital__ring orbital__ring--c"></span>
            <span class="orbital__ring orbital__ring--d"></span>
            <span class="orbital__core"></span>
            <span class="orbital__sat orbital__sat--a"></span>
            <span class="orbital__sat orbital__sat--b"></span>
          </div>
        </div>
        <canvas class="hero__canvas" id="hero-canvas" aria-hidden="true"></canvas>
        <div class="hero__scene-meta mono-label">
          <span>Orbital study / 01</span>
          <span data-scene-mode>Static</span>
        </div>
      </div>
    </div>

    <div class="hero__footer">
      <div class="hero__intro">
        <span class="mono-label">Profile</span>
        <p>{identity.intro}</p>
      </div>

      <div class="hero__actions">
        <Button href="#projects" variant="primary" arrow="down">Explore selected work</Button>
        <Button href="#about" variant="text" arrow="right">Read the profile</Button>
      </div>

      <div class="hero__aside">
        <SocialLinks />
        <a class="scroll-cue" href="#projects" aria-label="Scroll to selected projects">
          <span class="scroll-cue__track" aria-hidden="true"><span></span></span>
          <span class="mono-label">Scroll</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const host = canvas?.closest<HTMLElement>('.hero__scene') ?? null;
  const sceneMode = document.querySelector<HTMLElement>('[data-scene-mode]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const supportsWebGL = () => {
    try {
      const probe = document.createElement('canvas');
      return Boolean(probe.getContext('webgl2') ?? probe.getContext('webgl'));
    } catch {
      return false;
    }
  };

  if (canvas && host && !reduceMotion && supportsWebGL()) {
    const start = async () => {
      if (!canvas.isConnected) return;

      try {
        const { createHeroScene } = await import('../three/HeroScene');
        const handle = await createHeroScene({
          canvas,
          host,
          reducedMotion: false,
          onReady: () => {
            document.documentElement.classList.add('scene-ready');
            if (sceneMode) sceneMode.textContent = 'WebGL';
          },
        });

        window.addEventListener('pagehide', () => handle.dispose(), { once: true });
      } catch (error) {
        canvas.dataset.failed = 'true';
        console.warn('The 3D hero scene could not start; the static orbital fallback remains active.', error);
      }
    };

    const schedule = () => {
      const idleWindow = window as Window & {
        requestIdleCallback?: (
          callback: IdleRequestCallback,
          options?: IdleRequestOptions,
        ) => number;
      };

      if (typeof idleWindow.requestIdleCallback === 'function') {
        idleWindow.requestIdleCallback(() => void start(), { timeout: 1600 });
      } else {
        window.setTimeout(() => void start(), 280);
      }
    };

    if (document.readyState === 'complete') schedule();
    else window.addEventListener('load', schedule, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: clip;
    background: var(--bg);
  }

  .hero__ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero__ambient-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(241, 239, 230, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(241, 239, 230, 0.035) 1px, transparent 1px);
    background-size: 100% 9rem, 25% 100%;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.8), transparent 88%);
  }

  .hero__ambient-glow {
    position: absolute;
    top: -30%;
    right: -12%;
    width: min(70vw, 55rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 244, 90, 0.075), transparent 62%);
    filter: blur(20px);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(1.1rem, 3.5vh, 2.5rem));
    padding-bottom: clamp(1.25rem, 3vh, 2rem);
  }

  .hero__meta {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink-soft);
  }

  .hero__discipline {
    text-align: center;
  }

  .hero__folio {
    text-align: right;
  }

  .hero__stage {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    min-height: clamp(25rem, 50vh, 38rem);
    padding-block: clamp(1.75rem, 4vh, 3rem);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--muted-strong);
    animation: fade-up 900ms var(--ease-out) 180ms both;
  }

  .hero__eyebrow span {
    color: var(--lime);
  }

  .hero__title {
    display: flex;
    align-items: flex-end;
    margin-top: clamp(0.5rem, 1.5vh, 1rem);
    font-size: clamp(6rem, 18.6vw, 20rem);
    font-weight: 720;
    line-height: 0.76;
    letter-spacing: -0.012em;
  }

  .hero__line {
    display: block;
    overflow: clip;
    padding-block: 0.04em 0.035em;
  }

  .hero__name {
    display: block;
    animation: rise-in 1100ms var(--ease-out) 120ms both;
  }

  .hero__title-dot {
    width: 0.085em;
    height: 0.085em;
    margin-left: 0.06em;
    margin-bottom: 0.105em;
    background: var(--lime);
    animation: fade-in 500ms var(--ease-out) 950ms both;
  }

  .hero__statement {
    max-width: 35ch;
    margin-top: clamp(1rem, 2.5vh, 1.8rem);
    font-size: clamp(1.2rem, 1.65vw, 1.55rem);
    line-height: 1.4;
    color: var(--ink-soft);
    animation: fade-up 950ms var(--ease-out) 520ms both;
  }

  .hero__statement em {
    font-family: var(--font-serif);
    font-size: 1.1em;
    font-style: italic;
    color: var(--ink);
  }

  .hero__scene {
    position: absolute;
    top: 50%;
    right: calc(var(--gutter) * -0.72);
    z-index: 1;
    width: clamp(24rem, 46vw, 43rem);
    aspect-ratio: 1;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .hero__scene::before {
    content: '';
    position: absolute;
    inset: 12%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 244, 90, 0.09), transparent 66%);
    filter: blur(18px);
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  :global(.scene-ready) .hero__canvas {
    opacity: 1;
  }

  .hero__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: opacity 1.1s var(--ease-out);
  }

  :global(.scene-ready) .hero__fallback {
    opacity: 0.08;
  }

  .orbital {
    position: relative;
    width: 84%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    animation: fade-in 1.5s var(--ease-out) 400ms both;
  }

  .orbital__ring {
    position: absolute;
    border-radius: 50%;
    animation: orbit-drift 32s var(--ease-in-out) infinite;
  }

  .orbital__ring--a {
    inset: 7%;
    border: 1px solid rgba(201, 244, 90, 0.52);
    --tilt: -18deg;
    --squash: 0.4;
    animation-duration: 26s;
  }

  .orbital__ring--b {
    inset: 2%;
    border: 1px solid rgba(241, 239, 230, 0.16);
    --tilt: 24deg;
    --squash: 0.24;
    animation-duration: 38s;
    animation-direction: reverse;
  }

  .orbital__ring--c {
    inset: 14%;
    border: 1px dashed rgba(127, 159, 255, 0.42);
    --tilt: 68deg;
    --squash: 0.54;
    animation-duration: 30s;
    animation-delay: -9s;
  }

  .orbital__ring--d {
    inset: 21%;
    border: 1px solid rgba(241, 239, 230, 0.12);
    --tilt: 0deg;
    --squash: 0.86;
    animation-duration: 46s;
    animation-direction: reverse;
  }

  .orbital__core {
    position: relative;
    width: 32%;
    aspect-ratio: 1;
    border: 1px solid rgba(201, 244, 90, 0.42);
    border-radius: 50%;
    background: radial-gradient(circle at 36% 33%, #f2ffd1, #aacf3d 18%, #39451d 48%, #0c0e0a 78%);
    box-shadow:
      0 0 4rem rgba(201, 244, 90, 0.14),
      inset 0 0 2rem rgba(0, 0, 0, 0.65);
    animation: core-breathe 8s ease-in-out infinite;
  }

  .orbital__core::after {
    content: '';
    position: absolute;
    inset: 24%;
    border: 1px solid rgba(241, 239, 230, 0.38);
    transform: rotate(38deg);
  }

  .orbital__sat {
    position: absolute;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0.9rem rgba(201, 244, 90, 0.55);
  }

  .orbital__sat--a {
    top: 21%;
    left: 20%;
  }

  .orbital__sat--b {
    right: 16%;
    bottom: 31%;
    width: 0.28rem;
    height: 0.28rem;
    background: var(--blue);
    box-shadow: 0 0 0.9rem rgba(127, 159, 255, 0.5);
  }

  .hero__scene-meta {
    position: absolute;
    right: 18%;
    bottom: 5%;
    display: flex;
    gap: 1.1rem;
    color: var(--muted);
    font-size: 0.58rem;
    animation: fade-in 1s var(--ease-out) 1s both;
  }

  .hero__scene-meta span + span::before {
    content: '/';
    margin-right: 1.1rem;
    color: var(--line-strong);
  }

  .hero__footer {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) auto minmax(0, 0.45fr);
    align-items: end;
    gap: clamp(1.4rem, 3vw, 3rem);
    padding-top: clamp(1.1rem, 2.5vh, 1.6rem);
    border-top: 1px solid var(--line);
    animation: fade-up 950ms var(--ease-out) 700ms both;
  }

  .hero__intro {
    display: grid;
    gap: 0.55rem;
    max-width: 37ch;
  }

  .hero__intro p {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted-strong);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .hero__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.3rem;
  }

  .scroll-cue {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--muted);
  }

  .scroll-cue__track {
    position: relative;
    display: block;
    width: 2.8rem;
    height: 1px;
    overflow: hidden;
    background: var(--line);
  }

  .scroll-cue__track span {
    position: absolute;
    inset: 0;
    background: var(--lime);
    transform-origin: left;
    animation: scroll-pulse 2.8s var(--ease-in-out) infinite;
  }

  .scroll-cue:hover {
    color: var(--ink);
  }

  :global(.scene-ready) .orbital {
    animation-play-state: paused;
  }

  @media (max-width: 1180px) {
    .hero__scene {
      right: calc(var(--gutter) * -1.2);
      width: clamp(23rem, 44vw, 36rem);
    }

    .hero__footer {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .hero__aside {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (max-width: 900px) {
    .hero__meta {
      grid-template-columns: 1fr auto;
    }

    .hero__discipline {
      display: none;
    }

    .hero__title {
      font-size: clamp(5.5rem, 19vw, 12rem);
    }

    .hero__scene {
      width: clamp(20rem, 54vw, 30rem);
    }

    .hero__footer {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .hero__aside {
      grid-column: auto;
    }
  }

  @media (max-width: 767px) {
    .hero__inner {
      min-height: auto;
      padding-top: calc(var(--header-h) + 1rem);
      padding-bottom: 1.5rem;
    }

    .hero__meta {
      grid-template-columns: 1fr auto;
      gap: 1rem;
    }

    .hero__status {
      max-width: 24ch;
      font-size: 0.58rem;
    }

    .hero__discipline {
      display: none;
    }

    .hero__folio {
      font-size: 0.58rem;
    }

    .hero__stage {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding-block: clamp(1.6rem, 4vh, 2.4rem) 0;
    }

    .hero__title {
      font-size: clamp(5.1rem, 25vw, 8.4rem);
      margin-top: 0.7rem;
    }

    .hero__eyebrow {
      font-size: 0.58rem;
      letter-spacing: 0.09em;
    }

    .hero__statement {
      max-width: 32ch;
      margin-top: 1.2rem;
      font-size: 1.1rem;
    }

    .hero__scene {
      position: relative;
      top: auto;
      right: auto;
      order: 2;
      align-self: flex-end;
      width: min(76vw, 18rem);
      margin-top: -0.4rem;
      margin-right: calc(var(--gutter) * -0.35);
      transform: none;
    }

    .hero__scene::before {
      inset: 16%;
    }

    .hero__scene-meta {
      right: 9%;
      bottom: 2%;
      font-size: 0.52rem;
    }

    .hero__footer {
      gap: 1.25rem;
      padding-top: 1.25rem;
    }

    .hero__intro p {
      font-size: 0.82rem;
    }

    .hero__actions {
      gap: 1.1rem;
      justify-content: space-between;
    }

    .hero__aside {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .scroll-cue {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .hero__title {
      font-size: clamp(4.7rem, 25vw, 6.5rem);
    }

    .hero__status {
      max-width: 19ch;
    }

    .hero__actions :global(.btn) {
      flex: 1;
    }
  }
</style>
