---
import { portfolio } from '../../data/portfolio';

const { skillGroups } = portfolio;
---

<section class="skills" id="skills" data-section aria-labelledby="skills-title">
  <div class="shell">
    <header class="skills__header" data-reveal>
      <p class="skills__label">Technologies</p>
      <h2 class="skills__title" id="skills-title">Technical Expertise</h2>
      <p class="skills__intro">
        Organized by capability. These are the languages, frameworks and engineering fundamentals
        I work with.
      </p>
    </header>

    <div class="skills__grid" data-reveal-group>
      {
        skillGroups.map((group, i) => (
          <div key={i} class="skills__card" data-reveal-item>
            <div class="skills__card-header">
              <span class="skills__card-title">{group.title}</span>
              {group.title === 'Core Programming' && (
                <span class="skills__card-promise">Fundamental</span>
              )}
            </div>
            <ul class="skills__card-list">
              {group.items.map((item, j) => (
                <li key={j} class="skills__card-item">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills {
    padding-block: clamp(5rem, 8vw, 7rem);
    background:
      radial-gradient(circle at 12% 18%, rgba(127, 159, 255, 0.05), transparent 24rem),
      var(--bg);
  }

  .skills__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.56fr);
    gap: 1.5rem clamp(2rem, 7vw, 7rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .skills__label {
    margin-bottom: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .skills__title {
    font-family: var(--font-sans);
    font-size: clamp(2.4rem, 4.2vw, 3.8rem);
    font-weight: 480;
    line-height: 0.98;
    letter-spacing: -0.05em;
    text-transform: none;
  }

  .skills__intro {
    max-width: 45ch;
    justify-self: end;
    color: var(--muted-strong);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 4rem);
  }

  .skills__card {
    background: rgba(241, 239, 230, 0.03);
    border: 1px solid rgba(241, 239, 230, 0.02);
    border-radius: 0;
    transition: transform var(--dur-fast) ease, background-color var(--dur-fast) ease;
  }

  .skills__card:hover {
    background: rgba(241, 239, 230, 0.05);
    transform: translateY(-2px);
  }

  .skills__card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(241, 239, 230, 0.02);
  }

  .skills__card-title {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 560;
    line-height: 1.3;
    color: var(--ink);
  }

  .skills__card-promise {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lime);
    margin-left: auto;
    font-weight: 600;
  }

  .skills__card-list {
    padding: 0.8rem 1.5rem;
  }

  .skills__card-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .skills__card-item::before {
    content: '';
    width: 0.3rem;
    height: 0.3rem;
    flex: none;
    background: var(--lime);
    border-radius: 50%;
  }

  @media (max-width: 1000px) {
    .skills__header {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .skills__intro {
      justify-self: start;
    }

    .skills__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .skills__grid {
      gap: 1.5rem;
    }
  }
</style>