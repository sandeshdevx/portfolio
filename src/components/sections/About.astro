---
import { portfolio } from '../../data/portfolio';

const { identity } = portfolio;
---

<section class="about" id="about" data-section aria-labelledby="about-title">
  <div class="about__inner shell">
    <header class="about__top" data-reveal>
      <p class="about__label">About</p>
      <h2 class="about__title" id="about-title">
        A student engineer with a bias for <span>clarity.</span>
      </h2>
    </header>

    <div class="about__layout">
      <div class="about__story" data-reveal-group>
        <p class="about__lead" data-reveal-item>{identity.about[0]}</p>
        {
          identity.about.slice(1).map((paragraph) => (
            <p data-reveal-item>{paragraph}</p>
          ))
        }
        <p class="about__focus" data-reveal-item>
          <span>Current focus</span>
          Building complete web products, learning how applied AI behaves outside a demo, and keeping
          privacy decisions close to the architecture.
        </p>
      </div>

      <aside class="about__facts" data-reveal aria-label="Technical interests">
        <div class="about__monogram" aria-hidden="true">{identity.monogram}</div>

        <div class="about__interests">
          <p class="about__fact-label">Technical interests</p>
          <ul>
            {
              identity.interests.map((interest) => (
                <li>{interest}</li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>

    <div class="about__approach" data-reveal-group>
      <p class="about__approach-label">How I work</p>
      <div class="about__notes">
        {
          identity.approach.map((note) => (
            <article class="about__note" data-reveal-item>
              <span class="about__note-mark" aria-hidden="true"></span>
              <h3>{note.title}</h3>
              <p>{note.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding-block: clamp(5.5rem, 10vw, 9rem);
    overflow: clip;
    background:
      radial-gradient(circle at 84% 18%, rgba(201, 244, 90, 0.055), transparent 27rem),
      var(--bg-soft);
  }

  .about__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(2rem, 6vw, 6rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .about__label,
  .about__approach-label {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .about__title {
    max-width: 25ch;
    font-family: var(--font-sans);
    font-size: clamp(2.3rem, 4.4vw, 4.4rem);
    font-weight: 480;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-transform: none;
    text-align: right;
  }

  .about__title span {
    color: var(--lime);
  }

  .about__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 0.7fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .about__story {
    max-width: 66ch;
  }

  .about__story p {
    color: var(--muted-strong);
    font-size: clamp(0.98rem, 1.2vw, 1.08rem);
    line-height: 1.75;
  }

  .about__story p + p {
    margin-top: 1.35rem;
  }

  .about__story .about__lead {
    color: var(--ink);
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    line-height: 1.6;
  }

  .about__focus {
    display: grid;
    gap: 0.55rem;
    margin-top: 2.2rem;
    padding-left: 1.2rem;
    border-left: 2px solid var(--lime);
  }

  .about__focus span {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .about__facts {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--ink);
    color: var(--bg);
  }

  .about__monogram {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: clamp(2.4rem, 5vw, 4rem);
    background: var(--lime);
    color: var(--lime-ink);
    font-family: var(--font-display);
    font-size: 3.2rem;
    font-weight: 700;
    line-height: 1;
  }

  .about__fact-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(10, 11, 9, 0.55);
  }

  .about__degree {
    max-width: 20ch;
    margin-top: 0.65rem;
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--bg);
  }

  .about__institution {
    margin-top: 0.55rem;
    color: rgba(10, 11, 9, 0.72);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .about__standing {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(10, 11, 9, 0.72);
  }

  .about__standing span {
    width: 0.46rem;
    height: 0.46rem;
    background: var(--bg);
  }

  .about__interests {
    margin-top: clamp(2.4rem, 5vw, 3.5rem);
    padding-top: 1.2rem;
    border-top: 1px solid rgba(10, 11, 9, 0.18);
  }

  .about__interests ul {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .about__interests li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: rgba(10, 11, 9, 0.78);
    font-size: 0.84rem;
    line-height: 1.4;
  }

  .about__interests li::before {
    content: '';
    width: 0.26rem;
    height: 0.26rem;
    flex: none;
    background: var(--bg);
  }

  .about__approach {
    display: grid;
    grid-template-columns: minmax(8rem, 0.24fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .about__approach-label {
    color: var(--muted);
  }

  .about__notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .about__note-mark {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    margin-bottom: 1.4rem;
    background: var(--lime);
  }

  .about__note h3 {
    max-width: 18ch;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-transform: none;
  }

  .about__note p {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  @media (max-width: 1000px) {
    .about__layout {
      grid-template-columns: 1fr;
    }

    .about__facts {
      position: static;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) minmax(15rem, 0.8fr);
      gap: 2rem;
      align-items: start;
    }

    .about__monogram {
      margin-bottom: 0;
    }

    .about__interests {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    .about__approach {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 767px) {
    .about__top {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.2rem;
    }

    .about__title {
      text-align: left;
    }

    .about__facts {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 1.5rem;
    }

    .about__interests {
      grid-column: 1 / -1;
      padding-top: 1.2rem;
      border-top: 1px solid rgba(10, 11, 9, 0.18);
    }

    .about__notes {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about__note {
      display: grid;
      grid-template-columns: 1rem minmax(0, 1fr);
      gap: 0 0.75rem;
    }

    .about__note-mark {
      grid-row: span 2;
      margin-top: 0.35rem;
      margin-bottom: 0;
    }
  }

  @media (max-width: 520px) {
    .about__facts {
      display: block;
    }

    .about__monogram {
      margin-bottom: 2rem;
    }

    .about__interests {
      margin-top: 2rem;
    }
  }
</style>
