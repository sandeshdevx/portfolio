---
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import type { Project } from '../../data/portfolio';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const caseHref = `/work/${project.id}`;
---

<article
  id={`project-${project.id}`}
  class:list={['project', `project--${project.id}`]}
  data-reveal
>
  <header class="project__head">
    <p class="project__category">{project.category}</p>
    <a class="project__case-top" href={caseHref}>
      Case study
      <ArrowRight size={15} stroke-width={1.5} aria-hidden="true" />
    </a>
  </header>

  <div class="project__showcase">
    <div class="project__content">
      <h3 class="project__title">{project.name}</h3>
      <p class="project__tagline">{project.tagline}</p>
      <p class="project__summary">{project.summary}</p>

      <p class="project__stack">
        <span>Stack</span>
        {project.stack.join(' / ')}
      </p>

      <div class="project__actions">
        <a class="project__primary" href={caseHref}>
          Read the case study
          <ArrowRight size={16} stroke-width={1.5} aria-hidden="true" />
        </a>
        {
          project.links.map((link) => (
            <a
              class="project__secondary"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.label} for ${project.name} — opens in a new tab`}
            >
              {link.label}
              <ArrowUpRight size={15} stroke-width={1.5} aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>

    <div class="project__evidence">
      {project.id === 'curionest' ? (
        // CampusPool project snapshot — text-only editorial panel
        <div class="project__snapshot">
          <div class="project__snapshot-header">
            <h4 class="project__snapshot-title">PROJECT SNAPSHOT</h4>
            <p class="project__snapshot-sub">01 / CAMPUS MOBILITY</p>
          </div>
          <div class="project__snapshot-metrics">
            <div class="project__snapshot-metric">
              <p class="project__snapshot-metric-number">08</p>
              <p class="project__snapshot-metric-label">Frontend screens</p>
            </div>
            <div class="project__snapshot-metric">
              <p class="project__snapshot-metric-number">15+</p>
              <p class="project__snapshot-metric-label">REST API integrations</p>
            </div>
            <div class="project__snapshot-metric">
              <p class="project__snapshot-metric-number">04</p>
              <p class="project__snapshot-metric-label">Team engineers</p>
            </div>
          </div>
          <div class="project__snapshot-separator" />
          <div class="project__snapshot-implemented">
            <h5 class="project__snapshot-section">IMPLEMENTED MODULES</h5>
            <ul class="project__snapshot-module-list">
              <li class="project__snapshot-module-item">Ride Search</li>
              <li class="project__snapshot-module-item">Offer a Ride</li>
              <li class="project__snapshot-module-item">Inbox</li>
              <li class="project__snapshot-module-item">Carbon Wallet</li>
              <li class="project__snapshot-module-item">Subscription Pools</li>
            </ul>
          </div>
          <div class="project__snapshot-contribution">
            <h5 class="project__snapshot-section">MY CONTRIBUTION</h5>
            <p class="project__snapshot-contribution-text">
              "Primarily responsible for frontend engineering in a collaborative four-member
              development team. Developed eight frontend screens and integrated 15+ REST API
              endpoints."
            </p>
          </div>
          <div class="project__snapshot-achievement">
            <span class="project__snapshot-achievement-badge">WINNER — VIBETHON 2026</span>
            <p class="project__snapshot-achievement-issuer">
              IEEE Computer Society, NHCE Student Branch
            </p>
            <p class="project__snapshot-achievement-note">
              Team achievement
            </p>
          </div>
        </div>
      ) : (
        project.image ? (
          <>
            <figure class="project__figure">
              <picture>
                {project.image.mobileSrc && (
                  <source media="(max-width: 767px)" srcset={project.image.mobileSrc} />
                )}
                <img
                  src={project.image.src}
                  alt={project.image.alt}
                  width="1440"
                  height="1000"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              {project.id === 'curionest' && project.image.mobileSrc && (
                <span class="project__phone" aria-hidden="true">
                  <img
                    src={project.image.mobileSrc}
                    alt=""
                    width="430"
                    height="932"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )}
            </figure>
            <p class="project__caption">{project.image.caption}</p>
          </>
        ) : (
          <div class="project__record">
            <p class="project__record-label">Interface capture</p>
            <p class="project__record-title">Not published.</p>
            <p class="project__record-copy">{project.evidenceNote}</p>
          </div>
        )
      )}
    </div>
  </div>

  <div class="project__details">
    <div class="project__detail">
      <h4>Problem</h4>
      <p>{project.problem}</p>
    </div>
    <div class="project__detail">
      <h4>Implementation</h4>
      <p>{project.approach}</p>
    </div>
    <div class="project__detail">
      <h4>Outcome</h4>
      <p>{project.outcome}</p>
    </div>
  </div>

  {
    project.boundary && (
      <p class="project__note">{project.boundary}</p>
    )
  }
</article>

<style>
  .project {
    position: relative;
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
    border-top: 1px solid var(--line);
  }

  .project:last-child {
    border-bottom: 1px solid var(--line);
  }

  .project__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.8rem, 4vw, 3rem);
  }

  .project__category {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .project__case-top {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color var(--dur-fast) ease;
  }

  .project__case-top:hover {
    color: var(--lime);
  }

  .project__showcase {
    display: grid;
    grid-template-columns: minmax(0, 0.76fr) minmax(0, 1.24fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .project__content {
    min-width: 0;
  }

  .project__title {
    max-width: 9ch;
    font-size: clamp(4.2rem, 8vw, 8.2rem);
    line-height: 0.8;
    letter-spacing: 0.005em;
  }

  .project__tagline {
    max-width: 30ch;
    margin-top: 1.2rem;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.5;
    color: var(--ink);
  }

  .project__summary {
    max-width: 48ch;
    margin-top: 1.2rem;
    color: var(--muted-strong);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .project__stack {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1.7rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    line-height: 1.7;
  }

  .project__stack span {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .project__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.3rem;
    margin-top: 1.8rem;
  }

  .project__primary,
  .project__secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color var(--dur-fast) ease;
  }

  .project__primary {
    color: var(--lime);
  }

  .project__secondary {
    color: var(--muted-strong);
  }

  .project__primary:hover,
  .project__secondary:hover {
    color: var(--ink);
  }

  .project__primary svg,
  .project__secondary svg {
    transition: transform var(--dur-med) var(--ease-out);
  }

  .project__primary:hover svg {
    transform: translateX(3px);
  }

  .project__secondary:hover svg {
    transform: translate(2px, -2px);
  }

  .project__evidence {
    min-width: 0;
  }

  .project__figure {
    position: relative;
    isolation: isolate;
  }

  .project__figure picture,
  .project__figure > picture > img {
    display: block;
    width: 100%;
  }

  .project__figure img {
    height: auto;
    box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.28);
  }

  .project__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(241, 239, 230, 0.1);
  }

  .project__caption {
    margin-top: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .project__phone {
    position: absolute;
    right: -1.2rem;
    bottom: -2.8rem;
    z-index: 2;
    width: min(23%, 11rem);
    padding: 0.35rem;
    background: var(--bg);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.35);
  }

  .project__phone img {
    width: 100%;
    height: auto;
  }

  .project__record {
    min-height: clamp(20rem, 35vw, 32rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.5rem, 4vw, 3rem);
    background:
      linear-gradient(145deg, rgba(127, 159, 255, 0.1), transparent 55%),
      var(--bg-panel);
    border: 1px solid var(--line);
  }

  .project__record-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .project__record-title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 600;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .project__record-copy {
    max-width: 38ch;
    margin-top: 1.2rem;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.65;
  }

  .project__details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: clamp(2.8rem, 6vw, 5rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }

  .project__detail h4 {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--lime);
  }

  .project__detail p {
    max-width: 46ch;
    color: var(--muted-strong);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .project__note {
    max-width: 76ch;
    margin-top: 1.8rem;
    padding-left: 1rem;
    border-left: 1px solid var(--line-strong);
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.65;
  }

  .project--zenith .project__title {
    max-width: 8ch;
    font-size: clamp(5rem, 9.5vw, 10rem);
  }

  .project--smart-health-tracker {
    margin-top: clamp(1rem, 2.5vw, 2rem);
    padding: clamp(1.5rem, 4.5vw, 4rem);
    border: 0;
    background: var(--ink);
    color: var(--bg);
  }

  .project--smart-health-tracker .project__head {
    margin-bottom: 1.6rem;
  }

  .project--smart-health-tracker .project__category,
  .project--smart-health-tracker .project__case-top,
  .project--smart-health-tracker .project__summary,
  .project--smart-health-tracker .project__detail p {
    color: rgba(10, 11, 9, 0.64);
  }

  .project--smart-health-tracker .project__case-top {
    color: rgba(10, 11, 9, 0.8);
  }

  .project--smart-health-tracker .project__case-top:hover,
  .project--smart-health-tracker .project__primary {
    color: var(--bg);
  }

  .project--smart-health-tracker .project__secondary {
    color: rgba(10, 11, 9, 0.72);
  }

  .project--smart-health-tracker .project__title {
    max-width: 12ch;
    font-family: var(--font-sans);
    font-size: clamp(2.8rem, 5.5vw, 5.8rem);
    font-weight: 520;
    line-height: 0.95;
    letter-spacing: -0.055em;
    text-transform: none;
  }

  .project--smart-health-tracker .project__showcase {
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.85fr);
  }

  .project--smart-health-tracker .project__tagline {
    color: var(--bg);
  }

  .project--smart-health-tracker .project__stack {
    border-top-color: rgba(10, 11, 9, 0.2);
    color: rgba(10, 11, 9, 0.78);
  }

  .project--smart-health-tracker .project__stack span,
  .project--smart-health-tracker .project__caption {
    color: rgba(10, 11, 9, 0.54);
  }

  .project--smart-health-tracker .project__record {
    background: var(--bg);
    border-color: transparent;
  }

  .project--smart-health-tracker .project__record-title {
    color: var(--ink);
  }

  .project--smart-health-tracker .project__record-label {
    color: #4c65a8;
  }

  .project--smart-health-tracker .project__record-copy {
    color: var(--muted-strong);
  }

  .project--smart-health-tracker .project__details {
    border-top-color: rgba(10, 11, 9, 0.2);
  }

  .project--smart-health-tracker .project__detail h4 {
    color: rgba(10, 11, 9, 0.58);
  }

  .project--smart-health-tracker .project__note {
    border-left-color: rgba(10, 11, 9, 0.3);
    color: rgba(10, 11, 9, 0.62);
  }

  .project--curionest {
    margin-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--lime);
  }

  .project--curionest .project__head {
    margin-bottom: 1.6rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--lime);
  }

  .project--curionest .project__category {
    color: var(--lime);
  }

  .project--curionest .project__case-top {
    color: var(--ink-soft);
  }

  .project--curionest .project__case-top:hover {
    color: var(--lime);
  }

.project--curionest .project__title {
  max-width: 100%;
  font-family: var(--font-sans);
  font-size: clamp(3rem, 5.5vw, 6rem);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -0.055em;
  text-transform: none;
  color: var(--ink);
  overflow-wrap: anywhere;
}

  .project--curionest .project__tagline {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lime);
    margin-top: 0.8rem;
  }

  .project--curionest .project__summary {
    font-size: 0.94rem;
    line-height: 1.7;
    color: var(--muted-strong);
    margin-top: 1.5rem;
  }

  .project--curionest .project__stack {
    border-top-color: var(--lime);
    margin-top: 1.5rem;
    padding-top: 1rem;
    color: var(--lime);
  }

  .project--curionest .project__stack span {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .project--curionest .project__actions {
    margin-top: 1.5rem;
  }

  .project--curionest .project__primary {
    color: var(--lime);
  }

  .project--curionest .project__primary:hover {
    color: var(--bg);
  }

  .project--curionest .project__secondary {
    color: var(--muted-strong);
  }

  .project--curionest .project__secondary:hover {
    color: var(--bg);
  }

  .project--curionest .project__figure img {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top center;
    box-shadow: 0 4rem 8rem rgba(233, 69, 69, 0.4);
  }

  .project--curionest .project__phone {
    display: none;
  }

  .project--curionest .project__details {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .project--curionest .project__detail h4 {
    color: var(--lime);
    font-size: 0.68rem;
  }

  .project--curionest .project__detail p {
    color: var(--muted-strong);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .project--curionest .project__detail:first-child p {
    margin-top: 1rem;
  }

  .project--curionest .project__detail:last-child {
    grid-column: 1 / -1;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .project--curionest .project__note {
    max-width: 76ch;
    margin: 2rem 0 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--lime);
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .project--curionest .project__note .vibethon {
    color: var(--lime);
    font-weight: 600;
    font-size: 0.82rem;
  }

  @media (max-width: 1100px) {
    .project--curionest {
      margin-top: clamp(1.5rem, 5vw, 2rem);
    }

    .project--curionest .project__title {
      font-size: clamp(4rem, 12vw, 6rem);
    }

    .project--curionest .project__tagline {
      font-size: 0.76rem;
    }

    .project--curionest .project__summary {
      font-size: 0.9rem;
    }

    .project--curionest .project__stack {
      margin-top: 1rem;
    }
  }

  @media (max-width: 900px) {
    .project--curionest .project__title {
      font-size: clamp(3.5rem, 14vw, 5rem);
    }

    .project--curionest .project__details {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }

    .project--curionest .project__detail:last-child {
      grid-column: auto;
    }

    .project--curionest .project__note {
      margin: 1.5rem 0 0 0;
    }
  }

  @media (max-width: 767px) {
    .project--curionest .project__title {
      font-size: clamp(3.2rem, 16vw, 4.8rem);
    }

    .project--curionest .project__tagline {
      display: none;
    }

    .project--curionest .project__summary {
      max-width: 100%;
    }

    .project--curionest .project__stack {
      grid-column: 1;
    }

    .project--curionest .project__actions {
      grid-column: 1;
      margin-top: 1rem;
    }

    .project--curionest .project__note {
      border-left: none;
      padding-left: 0;
    }
  }

.project__snapshot {
  background: #F1EFE5;
  color: #171813;
  padding: clamp(1.5rem, 2.5vw, 2.25rem);
  min-height: 0;
  display: flex;
  flex-direction: column;
}

  .project__snapshot-header {
  margin-bottom: 1.25rem;
}

.project__snapshot-title {
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 4vw, 3.2rem);
  font-weight: 600;
  line-height: 0.95;
  letter-spacing: -0.02em;
  color: #171813;
  margin-bottom: 0.5rem;
}

  .project__snapshot-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #64748b;
  }
  .project__snapshot-metric {
    text-align: center;
  }

.project__snapshot-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.75rem;
  margin-bottom: 1.1rem;
}

.project__snapshot-metric-number {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 3.5vw, 3.2rem);
  font-weight: 600;
  line-height: 1;
  color: #171813;
}
  .project__snapshot-metric-label {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #64748b;
    margin-top: 0.35rem;
  }

.project__snapshot-separator {
  width: 100%;
  height: 1px;
  background: #d5d3c9;
  margin: 1rem 0;
}

.project__snapshot-implemented,
.project__snapshot-contribution,
.project__snapshot-achievement {
  margin-bottom: 1rem;
}
  
  .project__snapshot-section {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .project__snapshot-module-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.6rem 1rem;
  list-style: none;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  line-height: 1.5;
  color: #171813;
}

@media (max-width: 600px) {
  .project__snapshot-module-list {
    grid-template-columns: 1fr;
  }
}

  .project__snapshot-module-list > li {
    display: block;
    padding-left: 1.2rem;
    position: relative;
  }

  .project__snapshot-module-list > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8rem;
    width: 0.4rem;
    height: 0.4rem;
    background: #10b981;
    border-radius: 50%;
  }

  .project__snapshot-contribution-text {
  font-size: 0.86rem;
  line-height: 1.6;
  color: #3f3f46;
