---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Page not found — Sandesh"
  description="This route does not exist. Return to Sandesh's developer portfolio."
  noindex
  bodyClass="page-404"
>
  <section class="error" aria-labelledby="error-title">
    <div class="error__ambient" aria-hidden="true">
      <span class="error__orbit error__orbit--a"></span>
      <span class="error__orbit error__orbit--b"></span>
      <span class="error__orbit error__orbit--c"></span>
      <span class="error__core"></span>
    </div>

    <div class="error__inner shell">
      <div class="error__meta">
        <p class="mono-label">Error / 404</p>
        <p class="mono-label">Signal lost</p>
      </div>

      <div class="error__content">
        <p class="eyebrow">Outside the index</p>
        <h1 id="error-title">
          <span>404</span>
          <em>out of orbit.</em>
        </h1>
        <p class="error__copy">
          The page you were looking for is not part of this constellation. It may have moved, or
          the link may be incomplete.
        </p>
        <div class="error__actions">
          <Button href="/" variant="primary" arrow="right">Return home</Button>
          <Button href="/#projects" variant="ghost" arrow="down">View selected work</Button>
        </div>
      </div>

      <div class="error__foot mono-label">
        <span>Sandesh — Developer portfolio</span>
        <span>NHCE / CSE</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    overflow: clip;
    padding-top: var(--header-h);
  }

  .error__ambient {
    position: absolute;
    top: 50%;
    right: -8%;
    width: min(58vw, 44rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    transform: translateY(-50%);
    opacity: 0.75;
    pointer-events: none;
  }

  .error__orbit {
    position: absolute;
    border-radius: 50%;
  }

  .error__orbit--a {
    inset: 10%;
    border: 1px solid rgba(201, 244, 90, 0.3);
    transform: rotate(-22deg) scaleY(0.36);
  }

  .error__orbit--b {
    inset: 4%;
    border: 1px dashed rgba(241, 239, 230, 0.14);
    transform: rotate(36deg) scaleY(0.5);
  }

  .error__orbit--c {
    inset: 22%;
    border: 1px solid rgba(127, 159, 255, 0.24);
    transform: rotate(78deg) scaleY(0.62);
  }

  .error__core {
    width: 24%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 32%, #eaffb0, #83a52c 22%, #1c2212 62%, #090b07);
    box-shadow: 0 0 6rem rgba(201, 244, 90, 0.1);
  }

  .error__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(1.5rem, 4vh, 3rem);
  }

  .error__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .error__content {
    max-width: 54rem;
    padding-block: clamp(3rem, 10vh, 8rem);
  }

  .error__content h1 {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;
    font-size: clamp(6rem, 16vw, 15rem);
    line-height: 0.8;
  }

  .error__content h1 em {
    font-size: 0.62em;
    color: var(--muted-strong);
  }

  .error__copy {
    max-width: 42ch;
    margin-top: 2rem;
    color: var(--muted-strong);
    font-size: 1rem;
    line-height: 1.7;
  }

  .error__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
  }

  .error__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 720px) {
    .error__ambient {
      top: 30%;
      right: -30%;
      width: 90vw;
      opacity: 0.45;
    }

    .error__content h1 {
      font-size: clamp(5.5rem, 27vw, 9rem);
    }

    .error__foot {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
